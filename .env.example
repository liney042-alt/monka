# Web client (Vercel build variables)
VITE_API_BASE_URL=https://pet-pulse-api.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_EXTERNAL_CLERK_KEY

# API server (Render environment variables)
CLERK_AUTH_MODE=external
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_EXTERNAL_CLERK_KEY
CLERK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_EXTERNAL_CLERK_SECRET
DATABASE_URL=postgresql://REPLACE_WITH_SUPABASE_SESSION_POOLER_URL
ALLOWED_WEB_ORIGINS=https://pet-pulse.vercel.app
PETPULSE_ADMIN_EMAILS=admin@example.com
